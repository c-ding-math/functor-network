<div .container>
    <aside>
        <div .top>
            <div.user>
                $maybe avatar <- userAvatar author
                    <img.img-rounded src=#{avatar} alt=#{userName author}>
                $nothing
                    <img.img-rounded src=@{StaticR $ StaticRoute ["icons","default-avatar.svg"] []} alt=#{userName author}>
                <h1 .user-name.entry-title>#{userName author}
                <div .user-id>No. #{toPathPiece authorId}
                <div .user-actions>
                    $maybe (Entity userId user) <- maybeUserEntity
                        $if userId == authorId
                            <a.btn.btn-default href=@{SettingsR}>
                                _{MsgSettings}
                    $nothing
                        <a href=@{AuthR LoginR} .btn.btn-primary>
                            _{MsgSignUp} / _{MsgSignIn}

        <div .links>
        <div .bottom>
    <main>
        <div .wrapper>
            $maybe msg <- maybeMessage
            
                <div .alert.alert-info.alert-dismissible #message>
                    <button style="vertical-align: -0.125em;" type="button" class="close" data-dismiss="alert" aria-label="Close">
                        <span aria-hidden="true">&times;
                    <div .pull-left>
                        <svg .text-muted style="vertical-align: -0.125em;margin-right:1em;" xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-info-circle" viewBox="0 0 16 16"><path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/><path d="m8.93 6.588-2.29.287-.082.38.45.083c.294.07.352.176.288.469l-.738 3.468c-.194.897.105 1.319.808 1.319.545 0 1.178-.252 1.465-.598l.088-.416c-.2.176-.492.246-.686.246-.275 0-.375-.193-.304-.533zM9 4.5a1 1 0 1 1-2 0 1 1 0 0 1 2 0"/></svg>
                    <div>
                        #{msg}
            ^{widget}