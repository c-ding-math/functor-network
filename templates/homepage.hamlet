<div .jumbotron .text-center>
    <div .container>
        <div .row>
            <h1 .header>
                #{appName}
            <h2>
                a blog platform for mathematicians
                
            $maybe uid <- maybeUserId
                <a href=@{UserHomeR uid} .btn.btn-primary.btn-lg>
                    My Homepage
            $nothing
                <a href=@{AuthR LoginR} .btn.btn-primary.btn-lg>
                    Sign up / Sign in
                <a href=@{EntriesR} .btn.btn-default.btn-lg>
                    Explore Posts

<div .container>
    <div .bs-docs-section.fade-in-box>
            <h2>Native TeX Engine
            <p>Draft and publish rich mathematical content powered by a full TeX Live system. Enjoy full LaTeX compatibility right out of the box—import latex packages, define custom macros, or even paste existing TeX documents directly into your posts. 
            
